# Проверка tea.conf теми же правилами, что и программа. Пробелы срезаются обязательно: поля разделены
# "запятая + пробел", и без срезания awk видит " 80" вместо "80" и бракует всё подряд.
# Запятая внутри названия en="Milk, with a dash" полем не считается: разделителем служит только запятая
# вне кавычек, как и в программе.
/^[ \t]*#/ || /^[ \t]*$/ { next }
{
  line = $0
  fields = ""; field = ""; quoted = 0; n = 0
  for (i = 1; i <= length(line); i++) {
    c = substr(line, i, 1)
    if (c == "\"") { quoted = !quoted; field = field c; continue }
    if (c == "," && !quoted) {
      n++; f[n] = field
      sub(/^[ \t\r]+/, "", f[n]); sub(/[ \t\r]+$/, "", f[n])
      field = ""
      continue
    }
    field = field c
  }
  n++; f[n] = field
  sub(/^[ \t\r]+/, "", f[n]); sub(/[ \t\r]+$/, "", f[n])

  name = f[1]
  if (name !~ /^[a-z][a-z0-9_]{0,23}$/)
    printf "строка %d: недопустимое имя: %s\n", NR, (name == "" ? "(пусто)" : name)
  if (n < 3) {
    printf "строка %d: меньше трёх полей\n", NR
    next
  }
  if (f[2] !~ /^[0-9]+(\.[0-9]+)?$/ || f[2] + 0 <= 0 || f[2] + 0 > 100)
    printf "строка %d: температура вне (0, 100]: %s\n", NR, (f[2] == "" ? "(пусто)" : f[2])

  count = 0
  for (i = 3; i <= n; i++) {
    # Подпись: en="..." или ru="...". Язык, которого у сборки нет, пропускается, как и в программе.
    if (f[i] ~ /^(en|ru)="[^"]*"$/) continue
    # Закрывающая кавычка обязательна и здесь: без неё это не подпись на другом языке, а незакрытая
    # кавычка, которую программа отвергает вместе со строкой.
    if (f[i] ~ /^[a-z][a-z]="[^"]*"$/) continue
    count++
    if (f[i] !~ /^[0-9]+$/ || f[i] + 0 < 1 || f[i] + 0 > 3600)
      printf "строка %d: недопустимое время пролива: %s\n", NR, (f[i] == "" ? "(пусто)" : f[i])
  }
  if (count > 8)
    printf "строка %d: больше 8 проливов (%d)\n", NR, count
}
